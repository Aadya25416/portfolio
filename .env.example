# -----------------------------------------------------------------------------
# Portfolio Environment Variables Example
# -----------------------------------------------------------------------------
# Note: This is a static Next.js portfolio. All core content and functionality
# run out of the box with zero required environment variables.
#
# If you add external integrations (e.g., analytics, contact form webhooks, or custom CMS),
# duplicate this file to `.env.local` and supply your actual values.
# DO NOT commit `.env.local` or any secrets to GitHub.
# -----------------------------------------------------------------------------

# Canonical site URL (used for metadata / OpenGraph)
NEXT_PUBLIC_SITE_URL=https://aadyaagrawal.dev

# (Optional) Analytics / Tracking (e.g., Google Analytics, Vercel Analytics)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# (Optional) External Contact Form Webhook / Email Service
# CONTACT_FORM_ENDPOINT=https://api.example.com/contact

